{
  "name": "tweakhub",
  "version": "0.1.0",
  "private": true,
  "description": "TweakHub — 200+ file processing tools (PDF, images, video, audio, documents) for the African market.",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "dev:api": "cd apps/api && uvicorn main:app --reload --port 3001",
    "build": "npm run build --workspace=apps/web",
    "test": "npm run test --workspace=apps/web --if-present",
    "test:api": "cd apps/api && pytest -q"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
