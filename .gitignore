# Dependencies
node_modules/
.pnp
.pnp.js

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/

# Next.js
.next/
out/
# apps/web/tsconfig.json sets "incremental": true, so any tsc run
# (`next build`'s own check, or a standalone `tsc --noEmit`) regenerates
# this next to it.
*.tsbuildinfo

# Build outputs
build/
dist/

# Env files
.env
.env.local
.env.production
.env.*.local

# Logs
*.log
npm-debug.log*
logs/

# Uploads / generated files (never commit user file uploads)
uploads/
tmp/
storage_outputs/
# conftest.py sets DATABASE_URL to sqlite:///./_test.db, which resolves
# relative to whatever directory pytest is invoked from — apps/api itself
# for both CI (.github/workflows/test.yml) and the documented local
# workflow, not apps/api/tests — so this has to match both spots (a
# manual `cd tests && pytest` is unsupported but harmless to also ignore).
apps/api/_test.db
apps/api/tests/_test.db
apps/api/_alembic_tmp*.db

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Testing
coverage/
.pytest_cache/

# Docker
*.pid
*.rdb
