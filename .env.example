# --- Core ---
NODE_ENV=development
BASE_URL=http://localhost:3000
# In production (infrastructure/docker/docker-compose.yml + nginx.conf),
# the API is served by *path* on the SAME domain as the frontend
# (https://<domain>/api/...) -- there's no separate api. subdomain set up
# anywhere in this repo's DNS/nginx/certbot instructions. Keep API_URL
# (and NEXT_PUBLIC_API_URL below) equal to BASE_URL there; only give the
# API a different hostname if you've actually added a real api. vhost
# yourself (extra DNS record + `certbot -d api.<domain>` + a matching
# nginx server block).
API_URL=http://localhost:3001

# --- Database ---
# Only needed if you're pointing at an external managed Postgres/Redis
# instead of the bundled containers docker-compose.yml already brings up
# (which use POSTGRES_PASSWORD below, not these two) -- for local dev
# and the default single-VPS deploy, DATABASE_URL/REDIS_URL are set
# automatically. Set these explicitly to override that.
DATABASE_URL=postgresql://tweakhub:tweakhub@localhost:5432/tweakhub
REDIS_URL=redis://localhost:6379/0
# Password for the bundled Postgres container (infrastructure/docker/
# docker-compose.yml) -- change this for production; the default
# "tweakhub" is fine for local dev only.
POSTGRES_PASSWORD=tweakhub

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Payments: DPO Group (https://docs.dpopay.com) ---
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
DPO_API_BASE_URL=https://secure.dpogroup.com

# --- Payments: Ozow (South African instant EFT, https://ozow.com) ---
# Get these from the Ozow merchant dashboard. OZOW_IS_TEST defaults to
# true so a deployment that forgets to set it can't take real money.
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=
OZOW_API_BASE_URL=https://api.ozow.com
OZOW_IS_TEST=true

# --- File handling ---
MAX_UPLOAD_MB_FREE=10
MAX_UPLOAD_MB_PRO=100
MAX_UPLOAD_MB_BUSINESS=500
FILE_RETENTION_HOURS=48
UPLOAD_DIR=./uploads

# --- Rate limiting (Redis-backed, see apps/api/services/rate_limiter.py) ---
# Tool-processing limits, per user, keyed by plan tier:
RATE_LIMIT_FREE_PER_HOUR=100
RATE_LIMIT_PRO_PER_HOUR=1000
RATE_LIMIT_BUSINESS_PER_HOUR=5000
# Unauthenticated-endpoint limits, per client IP:
RATE_LIMIT_SIGNUP_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_HOUR=20
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5
RATE_LIMIT_PAYMENTS_CALLBACK_PER_HOUR=60

# --- DPO webhook hardening ---
# Comma-separated IPs/CIDRs DPO's payment callback is allowed to arrive
# from. Leave empty in dev. Get the real ranges from DPO support before
# launch — see config.py's dpo_webhook_ip_allowlist for why nothing is
# pre-filled here.
DPO_WEBHOOK_IP_ALLOWLIST=

# --- Object storage for processed outputs (services/storage_service.py) ---
# "local" (default) needs nothing else below — writes under
# STORAGE_LOCAL_DIR and serves files back through a signed URL, no cloud
# account required. Switch to "s3" for real AWS S3 or self-hosted MinIO
# (docker-compose brings up a minio service — see infrastructure/docker/
# docker-compose.yml — matching the S3_* defaults below).
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage_outputs
SIGNED_URL_EXPIRES_SECONDS=3600
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Server-side encryption requested on every S3 put_object. AES256 works
# with zero setup on real AWS S3. Self-hosted MinIO needs its own KMS/
# encryption configured first — set this to empty to disable if you
# haven't done that, or every save will fail.
S3_SERVER_SIDE_ENCRYPTION=AES256

# Encrypts local-backend files at rest (Fernet) before they touch disk —
# see services/storage_service.py. Leave empty to derive the key from
# JWT_SECRET (on by default, no extra config needed); set a dedicated
# value here in production so rotating JWT_SECRET doesn't also make every
# previously-stored file undecryptable.
STORAGE_ENCRYPTION_KEY=

# --- Background job queue (RQ, see apps/workers/README.md) ---
# Only video-category and document-engine tools go through this — see
# routes/tools.py's ASYNC_TOOL_NAMES. Leave JOB_QUEUE_REDIS_URL empty to
# reuse REDIS_URL (the default; separate it out only to isolate queue
# load from rate-limiting/cache traffic on the same Redis).
JOB_QUEUE_REDIS_URL=
JOB_QUEUE_NAME=tweakhub-tools
# Fallback only — per-tool timeouts (services/tool_timeouts.py) are used
# whenever enqueue_processing_job() is called with a tool_name, which is
# every real call site. This applies only if that's ever omitted.
JOB_TIMEOUT_SECONDS=900

# --- Transactional email (services/email_service.py) ---
# "console" (default) just logs the email — nothing else below needed,
# fine for local dev (copy the verification/reset link out of the server
# log). Switch to "smtp" for real delivery via any SMTP relay (SendGrid/
# Postmark/SES's SMTP endpoints, or a plain Gmail/Workspace account).
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=noreply@tweakhub.com

# --- Google OAuth (services/oauth_service.py) ---
# Gracefully disabled (not a 500) when the two client fields below are
# empty — GET /api/auth/google/status reports {"enabled": false} and the
# frontend simply doesn't show a "Sign in with Google" button. Get real
# values from https://console.cloud.google.com/apis/credentials — set the
# authorized redirect URI there to {API_URL}/api/auth/google/callback (or
# whatever you set GOOGLE_REDIRECT_URI to below).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Empty derives this from API_URL + /api/auth/google/callback at request
# time — only set it explicitly if that derived value is wrong (e.g. the
# API sits behind a different public hostname than API_URL).
GOOGLE_REDIRECT_URI=
# These three default to the real Google OAuth2 endpoints — no reason to
# change them outside of tests (see test_oauth_service.py / test_oauth_routes.py,
# which point them at a local stand-in server).
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo

# --- Frontend (Next.js public vars) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
